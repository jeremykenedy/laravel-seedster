{
    "name": "jeremykenedy/laravel-seedster",
    "description": "Register and run Laravel database seeds from packages. Fork of eklundkristoffer/seedster with Laravel 13+ support.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "seed",
        "seeder",
        "package"
    ],
    "authors": [
        {
            "name": "Jeremy Kenedy",
            "email": "jeremykenedy@gmail.com"
        },
        {
            "name": "Kristoffer Eklund",
            "email": "kristoffereklund1@gmail.com",
            "role": "Original Author"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jeremykenedy\\LaravelSeedster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeremykenedy\\LaravelSeedster\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/global_database_seeder.php"
        ]
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeremykenedy\\LaravelSeedster\\Providers\\SeedsterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
